# corpus-forge — Docker Postgres env-file template.
#
# Usage:
#   cp .env.postgres.example .env.postgres
#   # then edit the password before `docker compose up`.
#
# The CHANGEME_LONG_RANDOM placeholder MUST be replaced. The container
# image will start with whatever password you set here; if you ship the
# default to production the database is effectively unprotected on any
# network the container is reachable from.

POSTGRES_DB=corpus_forge
POSTGRES_USER=corpus_forge

# Replace this before running `docker compose up`. Recommended:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGEME_LONG_RANDOM
