<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__REVERSE_DNS__.corpus-forge</string>
    <key>ProgramArguments</key>
    <array>
        <string>__EXECUTABLE_PATH__/uv</string>
        <string>run</string>
        <string>corpus-forge</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>__EXECUTABLE_PATH__</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/corpus-forge.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/corpus-forge.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
    </dict>
</dict>
</plist>
